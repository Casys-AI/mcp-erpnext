{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./*"],
      "react": ["./node_modules/preact/compat/src/index.d.ts"],
      "react-dom": ["./node_modules/preact/compat/src/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime/src/index.d.ts"]
    }
  },
  "include": [
    "kpi-viewer/**/*.ts",
    "kpi-viewer/**/*.tsx",
    "funnel-viewer/**/*.ts",
    "funnel-viewer/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "**/*_test.ts"]
}
